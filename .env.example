# Local runs only. In GitHub these are repository secrets (see README).
# Copy to .env — never commit the real file.

# Anthropic API key (console.anthropic.com). Without it the site still builds,
# using a keyword filter and no summaries or briefings.
ANTHROPIC_API_KEY=

# X API v2 bearer token (developer.x.com). Optional; pay-per-use.
X_BEARER_TOKEN=

# Optional model overrides (defaults in config/site.yaml)
# OTASEC_CLASSIFY_MODEL=claude-haiku-5-5
# OTASEC_BRIEFING_MODEL=claude-sonnet-5-5
